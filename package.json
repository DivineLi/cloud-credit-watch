{
  "name": "cloud-credit-watch",
  "version": "1.0.6",
  "description": "DSH 插件：实时显示阿里云余额，包含学生 300 元代金券余额。自动定时刷新，聊天框下方直接看。",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "aliyun",
    "balance",
    "student",
    "阿里云",
    "余额",
    "学生优惠",
    "代金券"
  ],
  "author": "DivineLi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DivineLi/cloud-credit-watch.git"
  },
  "homepage": "https://github.com/DivineLi/cloud-credit-watch",
  "bugs": {
    "url": "https://github.com/DivineLi/cloud-credit-watch/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}